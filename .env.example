# Copy to .env (gitignored) and adjust as needed. docker-compose.yml reads these
# for interpolation; every value has a dev default so the stack also runs with no
# .env file at all. NEVER commit a real .env.

# --- Postgres -----------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cheapanalysis

# --- Backend (ASP.NET Core) ---------------------------------------------------
# Development enables Swagger + the dev connection string defaults.
ASPNETCORE_ENVIRONMENT=Development

# --- IBKR sidecar -------------------------------------------------------------
IBKR_SIDECAR_LOG_LEVEL=INFO

# --- Future (not wired yet) ---------------------------------------------------
# Uncomment once the relevant tasks land:
# ANTHROPIC_API_KEY=                 # AI summaries
# IBKR_USER=                         # IBKR Gateway (brokerage profile, later)
# IBKR_PASS=
