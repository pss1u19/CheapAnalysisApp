# Copy to .env (gitignored) and adjust as needed. docker-compose.yml reads these
# for interpolation; every value has a dev default so the stack also runs with no
# .env file at all. NEVER commit a real .env.

# --- Postgres -----------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cheapanalysis

# --- Backend (ASP.NET Core) ---------------------------------------------------
# Development enables Swagger + the dev connection string defaults.
ASPNETCORE_ENVIRONMENT=Development

# --- Redis --------------------------------------------------------------------
# Backs the Idempotency-Key middleware (T-018). The backend connects to redis:6379
# inside Compose by default, so no value is needed here. An empty connection string
# disables idempotency (no-op), the same pattern as the DB/Sentry settings.

# --- Observability (Sentry, T-017) --------------------------------------------
# Backend error reporting. Empty = Sentry disabled (no-op), so the stack still runs.
# Sentry derives its environment from ASPNETCORE_ENVIRONMENT.
SENTRY_DSN=
# The frontend DSN is public and baked at build time in
# frontend/src/environments/environment.ts — it is NOT read from this file.

# --- IBKR sidecar -------------------------------------------------------------
IBKR_SIDECAR_LOG_LEVEL=INFO

# --- Future (not wired yet) ---------------------------------------------------
# Uncomment once the relevant tasks land:
# ANTHROPIC_API_KEY=                 # AI summaries
# IBKR_USER=                         # IBKR Gateway (brokerage profile, later)
# IBKR_PASS=
