# =============================================================================
# CheapAnalysisApp — .gitignore
# Stack: .NET 8 | Angular 18/19 | Python (ibkr-sidecar) | Docker | PostgreSQL
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets & environment — NEVER commit these
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
user-secrets/
secrets/

# -----------------------------------------------------------------------------
# .NET / C#
# -----------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
*.ncrunchproject
*.ncrunch*
_NCrunch_*
nCrunchTemp_*
*.DotSettings.user

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/
project.lock.json
project.fragment.lock.json
artifacts/

# Publish output
publish/
**/[Pp]ublish/

# EF Core migrations (keep source, ignore compiled)
# (intentionally NOT ignoring Migrations/ — we commit them)

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml
coverage*/

# Rider
.idea/
*.sln.iml

# VS Code (keep tasks.json and launch.json if they exist)
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/settings.json

# -----------------------------------------------------------------------------
# Angular / Node
# -----------------------------------------------------------------------------
node_modules/
dist/
.angular/
.nx/

# Angular cache
.cache/
*.tsbuildinfo

# Parcel
.parcel-cache/

# npm / yarn / pnpm — debug logs and the local store are never committed
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Lockfiles. The frontend standardizes on pnpm (ARCHITECTURE §5), and its
# lockfile IS committed for reproducible installs — CI and Docker run
# `pnpm install --frozen-lockfile` (the npm-ci equivalent) against it. npm and
# yarn locks stay ignored: a stray one means the wrong package manager was used.
# The root tooling workspace (commitlint/husky) still uses npm and is not
# build-critical, so its lock remains ignored.
package-lock.json
yarn.lock
pnpm-lock.yaml
!/frontend/pnpm-lock.yaml

# Jest
coverage/

# Storybook
storybook-static/

# -----------------------------------------------------------------------------
# Python (ibkr-sidecar)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
pip-wheel-metadata/
*.egg-info/
.eggs/
*.egg
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
htmlcov/
.coverage
.coverage.*
coverage.xml

# Virtual environments
.venv/
venv/
env/
ENV/

# Protobuf generated stubs (regenerated by `make proto`)
ibkr-sidecar/*_pb2*.py
backend/**/*.cs.proto.g.cs

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
docker-compose.override.yml

# -----------------------------------------------------------------------------
# OS / IDE
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
*.log
*.tmp
*.bak
*.orig

# -----------------------------------------------------------------------------
# Local planning artifacts — kept loose in working tree, never committed
# -----------------------------------------------------------------------------
/TASKS.md
/docs/
/dashboard.html
/weekly-summary-*.md
