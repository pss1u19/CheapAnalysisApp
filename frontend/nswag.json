{
  "runtime": "Net80",
  "defaultVariables": "SwaggerUrl=http://backend:8080/swagger/v1/swagger.json",
  "documentGenerator": {
    "fromDocument": {
      "url": "$(SwaggerUrl)"
    }
  },
  "codeGenerators": {
    "openApiToTypeScriptClient": {
      "className": "{controller}Client",
      "moduleName": "",
      "namespace": "",
      "typeScriptVersion": 5.7,
      "template": "Angular",
      "rxJsVersion": 7.0,
      "dateTimeType": "Luxon",
      "nullValue": "Undefined",
      "generateClientClasses": true,
      "generateClientInterfaces": false,
      "generateOptionalParameters": true,
      "exportTypes": true,
      "wrapDtoExceptions": true,
      "exceptionClass": "ApiException",
      "useSingletonProvider": true,
      "injectionTokenType": "InjectionToken",
      "httpClass": "HttpClient",
      "withCredentials": true,
      "baseUrlTokenName": "API_BASE_URL",
      "generateDtoTypes": true,
      "operationGenerationMode": "MultipleClientsFromFirstTagAndOperationId",
      "markOptionalProperties": true,
      "generateResponseClasses": true,
      "responseClass": "ApiResponse",
      "generateAcceptHeaders": false,
      "useGetBaseUrlMethod": false,
      "queryNullValue": "",
      "typeStyle": "Class",
      "importRequiredTypes": true,
      "useTransformOptionsMethod": false,
      "useTransformResultMethod": false,
      "output": "src/app/api/cheap-analysis.client.ts"
    }
  }
}
