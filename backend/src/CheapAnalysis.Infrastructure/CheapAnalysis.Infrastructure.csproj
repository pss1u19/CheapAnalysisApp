<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Packages wired in later tasks:
      T-205 — (no extra pkg, uses System.Security.Cryptography built-in)
      T-207 — Hangfire.AspNetCore + Hangfire.PostgreSql
      T-404 — Grpc.Net.Client (transport) + ProjectReference to
              CheapAnalysis.Ibkr.Contracts, whose generated gRPC client stubs
              (from proto/ibkr.proto) were added in T-007.
  -->

  <ItemGroup>
    <!-- T-005: EF Core + Npgsql -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.9" />
    <!-- T-018: Redis-backed Idempotency-Key store. -->
    <PackageReference Include="StackExchange.Redis" Version="2.13.17" />
    <!-- Pin transitive: Npgsql 10.0.0 pulls System.Security.Cryptography.Xml 9.0.0,
         which carries GHSA-37gx-xxp4-5rgx / GHSA-w3x6-4m5h-cxqf. 10.0.8 is patched. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CheapAnalysis.Application\CheapAnalysis.Application.csproj" />
    <ProjectReference Include="..\CheapAnalysis.Domain\CheapAnalysis.Domain.csproj" />
  </ItemGroup>

</Project>
